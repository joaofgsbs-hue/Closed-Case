# Copy this file to ".env" and edit the values. ".env" is ignored by git.

# Port the game server listens on
PORT=3000

# "development" enables the debug model test on the home page. Use "production" when hosting.
NODE_ENV=development

# ---- Which AI model to use -------------------------------------------------
# "ollama"    = free, runs on your own computer
# "anthropic" = paid API, needs ANTHROPIC_API_KEY
LLM_PROVIDER=ollama

# How long to wait for the model before giving up (milliseconds)
LLM_TIMEOUT_MS=30000

# How many requests the model works on at once. 1 for Ollama; a cloud API can take more.
LLM_MAX_PARALLEL=1

# ---- Ollama (free, local) --------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# ---- Anthropic (paid, optional) --------------------------------------------
# Leave empty unless LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---- Case generation ---------------------------------------------------------
# Time limits for writing a whole case and for the check that it is solvable.
CASE_TIMEOUT_MS=240000
CASE_VERIFY_TIMEOUT_MS=120000
# Context size for the local model (tokens). 8192 fits a full case.
OLLAMA_NUM_CTX=8192

# ---- Investigation (shared by everyone in a room) ----------------------------
# Location searches per game. 0 = automatic (number of locations minus one).
ACTIONS_PER_DAY=0
# How many contradiction checks a room may ask for on the evidence board.
LINK_CHECKS_PER_ROOM=12

# ---- Interrogation limits (shared by everyone in a room) ---------------------
QUESTIONS_PER_SUSPECT=8
MAX_QUESTIONS_PER_ROOM=60
